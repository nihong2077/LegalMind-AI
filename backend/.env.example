# LegalMind AI 后端环境变量示例
# 用法：cp .env.example .env 并按需修改；compose 默认值见 docker-compose.yml

# ========== T0.8 Kafka 事件总线 ==========
# false：不连接 Kafka，事件走进程内降级（默认，开发期无需起 Kafka）
# true ：首次发事件时懒连；broker 不可用自动降级，不阻断 API 请求
ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=legalmind-backend
# 业务 topic（compose 的 kafka-init 会自动创建，3 partition）
KAFKA_TOPIC_TURNS=collab-turns
KAFKA_TOPIC_MEMORY=memory-events
KAFKA_TOPIC_DOC_TASKS=doc-tasks

# ========== T0.7 OpenTelemetry ==========
OTEL_ENABLED=true
OTEL_SERVICE_NAME=legalmind-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ========== T0.6 结构化日志 ==========
# json=生产 JSON 行；console=本地彩色
LOG_FORMAT=json
LOG_LEVEL=INFO

# ========== 统一信封 ==========
# /api/* 全部穿 ApiResponse 信封 {code,message,data,request_id}
